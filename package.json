{
  "name": "sales-customer-management-system",
  "version": "1.0.0",
  "description": "Sales Customer Management Web Application (CRM)",
  "private": true,
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
